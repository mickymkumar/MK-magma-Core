workspace(name = "magma")

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# ----------------------------
# Rules Python (updated)
# ----------------------------
http_archive(
    name = "rules_python",
    urls = ["https://github.com/bazelbuild/rules_python/archive/refs/tags/0.30.0.tar.gz"],
    strip_prefix = "rules_python-0.30.0",
    sha256 = "c0f47a708cf73533dbe06ad943dc2b5e54f9fdf0c5a47a4e36a0bb03d13aab8e",  # optional integrity check
)

load("@rules_python//python:pip.bzl", "pip_parse")

# ----------------------------
# Python dependencies
# ----------------------------
pip_parse(
    name = "python_deps",
    requirements_lock = "//:requirements.txt",
)

# Expose pip packages to Bazel
load("@python_deps//:requirements.bzl", "install_deps")

install_deps()

# ----------------------------
# Rules for Bazel C++ / Go / JS (keep as in Magma)
# ----------------------------

# Example: rules_cc
http_archive(
    name = "rules_cc",
    urls = ["https://github.com/bazelbuild/rules_cc/archive/refs/tags/0.0.5.tar.gz"],
    strip_prefix = "rules_cc-0.0.5",
)

# Example: rules_go
http_archive(
    name = "io_bazel_rules_go",
    urls = ["https://github.com/bazelbuild/rules_go/releases/download/v0.39.1/rules_go-v0.39.1.zip"],
    sha256 = "a3d7c2d7ec6a6a9f34d1f7135a9a179fa4dcbe6a5cb9f4b9d75a1435f2e5cf5a",
)

# Example: gazelle
http_archive(
    name = "bazel_gazelle",
    urls = ["https://github.com/bazelbuild/bazel-gazelle/releases/download/v0.28.0/bazel-gazelle-v0.28.0.tar.gz"],
    sha256 = "3a05f5e31b6d80a2b6bafbe2d0bcb9fa2fae622ed75d2e2e9fa3a1b2ffebf53d",
)

# ----------------------------
# Load Magma-specific rules, toolchains, etc.
# ----------------------------
load("//bazel:deps.bzl", "magma_deps")

magma_deps()
